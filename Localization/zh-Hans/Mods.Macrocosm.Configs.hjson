# Localization file for the configs

ClientConfig: {
	DisplayName: 客户端配置
	GameplayHeader: 游戏
	UIHeader: 用户界面
	VisualsHeader: 视觉

	AlwaysDisplayTitleCards: {
		Label: 始终显示天体名称
		Tooltip: 是否在每次到达一个新星球的时候显示一小段时间的天体名称,无论您是否到达过
	}

	GunRecoilEffects: {
		Label: 枪支的后坐力
		Tooltip: 枪支是否具有后坐力
	}

	UnitSystem: {
		Label: 单位标准
		Tooltip: 用于显示数值的单位标准
	}

	DisplayGravityInGs: {
		Label: 以G显示重力值
		Tooltip: 是否要以G（地球重力加速度）显示重力,或者以当前单位系统中测量的重力加速度显示
	}

	SelectedUITheme: {
		Label: UI主题
		Tooltip: 这个mod的UI显示主题
	}

	DisableSilicaSandGeneration: {
		Label: 禁用硅砂生成
		Tooltip: 禁用硅砂的生成,以避免破坏其他模组的生物群落.
	}

	DisableOilShaleGeneration: {
		Label: 禁用油页岩生成
