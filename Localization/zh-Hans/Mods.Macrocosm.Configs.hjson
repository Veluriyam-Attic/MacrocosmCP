	}

	Use3DCelestialBodies: {
		Label: 3D行星
		Tooltip: 启用 高分辨率的行星/卫星纹理
	}

	Headers: {
		GameplayHeader: 游玩
		UIHeader: UI
		VisualsHeader: 视觉
	}
}

