	Tooltip:
		'''
		當你的生命值在30%以下時，受到傷害的50%會改為損失魔力值而非生命值
		魔力值耗盡時，將繼續從生命值中扣除
		不能造成非魔法傷害
		不能同時佩戴魔法手銬
		'''
}

HummingbirdDroneRemote: {
	DisplayName: P.D.C.D.控製器
