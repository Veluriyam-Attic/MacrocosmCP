# Localization file for the configs

ClientConfig: {
	DisplayName: 客户端配置
	GameplayHeader: 游戏
	GraphicsHeader: 图案
	UIHeader: 用户界面

	AlwaysDisplayTitleCards: {
		Label: 始终显示天体名称
		Tooltip: 是否在每次到达一个新星球的时候显示一小段时间的天体名称，无论您是否到达过
	}

	GunRecoilEffects: {
		Label: 枪支的后坐力
		Tooltip: 枪支是否具有后坐力
	}

	HighResolutionEffects: {
		Label: 高分辨率效果
		Tooltip: 使用更高的分辨率视觉效果
	}

	UnitSystem: {
		Label: 单位标准
		Tooltip: 用于显示数值的单位标准
	}

	DisplayGravityInGs: {
		Label: 以G显示重力值
		Tooltip: 是否要以G（地球重力加速度）显示重力，或者以当前单位系统中测量的重力加速度显示
	}

	SelectedUITheme: {
		Label: UI主题
		Tooltip: 这个mod的UI显示主题
	}

	DisableSilicaSandGeneration: {
		Label: 禁用硅砂生成
		Tooltip: 禁用硅砂的生成，以避免破坏其他模组的生物群落.
	}

	DisableOilShaleGeneration: {
		Label: 禁用油页岩生成
		Tooltip: ""
	}
}

ServerConfig: {
	DisplayName: 服务器配置
	WorldGenHeader: 世界生成

	DisableSilicaSandGeneration: {
		Label: 禁用硅砂生成
		Tooltip: 禁用硅砂的生成，以避免破坏其他模组的生物群落.
	}

	DisableOilShaleGeneration: {
		Label: 禁用油页岩生成
		Tooltip: 禁用油页岩的生成，以避免破坏其他模组的生物群落.
	}

	Circuits: 电路

	CircuitSearchUpdateRate: {
		Label: 电路搜索更新频率
		Tooltip: 调整电路搜索的更新频率，单位为刻.值越高意味着搜索频率越低，这可能会提高性能.
	}

	CircuitSolveUpdateRate: {
		Label: 电路求解更新频率
		Tooltip: 调整电路求解的更新频率，单位为刻.值越高意味着求解频率越低，这可能会提高性能.
	}
}

